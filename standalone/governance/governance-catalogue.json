      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-access-least-privilege",
      "name": "User access follows least privilege and role-based approval",
      "description": "User access follows least privilege and role-based approval",
      "ruleType": "Security",
      "expression": "ACCESS <= ROLE_ENTITLEMENT",
