  "businessRules": [
    {
      "id": "rule-cdd-before-open",
      "name": "CDD must be complete before a customer relationship or account is activated",
      "description": "CDD must be complete before a customer relationship or account is activated",
      "ruleType": "Eligibility / compliance",
      "expression": "CDD_STATUS = COMPLETE",
      "ownerPositionId": "pos-onboarding-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-sanctions-clear",
      "name": "Unresolved sanctions matches prevent onboarding or payment release",
      "description": "Unresolved sanctions matches prevent onboarding or payment release",
      "ruleType": "Compliance",
      "expression": "SANCTIONS_STATUS = CLEAR",
      "ownerPositionId": "pos-mlro",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-affordability",
      "name": "A loan cannot be approved without a documented affordability assessment",
      "description": "A loan cannot be approved without a documented affordability assessment",
      "ruleType": "Credit",
      "expression": "AFFORDABILITY = PASS",
      "ownerPositionId": "pos-credit-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-credit-authority",
      "name": "Credit decisions must remain within delegated authority",
      "description": "Credit decisions must remain within delegated authority",
      "ruleType": "Credit",
      "expression": "AMOUNT <= APPROVER_LIMIT",
      "ownerPositionId": "pos-credit-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-fscs-disclosure",
      "name": "Eligible depositors receive required depositor-protection information",
      "description": "Eligible depositors receive required depositor-protection information",
      "ruleType": "Conduct",
      "expression": "FSCS_DISCLOSURE = SENT",
      "ownerPositionId": "pos-head-savings",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-payment-auth",
      "name": "Outbound payments require successful authentication and fraud checks",
      "description": "Outbound payments require successful authentication and fraud checks",
      "ruleType": "Payments",
      "expression": "AUTH = PASS AND FRAUD = CLEAR",
      "ownerPositionId": "pos-savings-ops-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-complaint-clock",
      "name": "Complaints are tracked against applicable acknowledgement/final-response deadlines",
      "description": "Complaints are tracked against applicable acknowledgement/final-response deadlines",
      "ruleType": "Conduct",
      "expression": "DUE_DATE >= TODAY",
      "ownerPositionId": "pos-customer-service-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-vulnerability",
      "name": "Recorded vulnerability or support needs trigger appropriate service adjustments",
      "description": "Recorded vulnerability or support needs trigger appropriate service adjustments",
      "ruleType": "Conduct",
      "expression": "VULNERABLE = TRUE => ADJUSTMENT_REQUIRED",
      "ownerPositionId": "pos-head-customer-ops",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-arrears-forbearance",
      "name": "Customers in financial difficulty are assessed for appropriate forbearance",
      "description": "Customers in financial difficulty are assessed for appropriate forbearance",
      "ruleType": "Collections",
      "expression": "FIN_DIFFICULTY = TRUE => FORBEARANCE_REVIEW",
      "ownerPositionId": "pos-collections-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-dual-journal",
      "name": "Material manual journals require independent approval",
      "description": "Material manual journals require independent approval",
      "ruleType": "Finance",
      "expression": "MATERIAL_JOURNAL = TRUE => SECOND_APPROVER",
      "ownerPositionId": "pos-finance-manager",
      "active": true,
      "notes": "Illustrative reference business rule."
    },
    {
      "id": "rule-retention",
      "name": "Data is retained only for the approved retention period unless a legal hold applies",
      "description": "Data is retained only for the approved retention period unless a legal hold applies",
      "ruleType": "Data",
      "expression": "RETENTION_DUE AND NOT LEGAL_HOLD => DISPOSE",
      "ownerPositionId": "pos-dpo",
