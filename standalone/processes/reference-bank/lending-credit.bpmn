<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_LendingCredit" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_LendingCredit" name="Lending &amp; Credit" isExecutable="false">
<bpmn:laneSet id="LaneSet_LendingCredit"><bpmn:lane id="Lane_LendingCredit" name="Simple Bank"><bpmn:flowNodeRef>Start_LendingCredit</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_1_LoanApplication</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_2_AffordabilityCreditAssessment</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_3_UnderwritingDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_4_LoanOfferDocumentation</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_5_LoanBookingDisbursement</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_6_LoanRepaymentProcessing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_7_ArrearsCollections</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_8_ForbearanceSupport</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_9_LoanSettlementClosure</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_10_CreditBureauReporting</bpmn:flowNodeRef><bpmn:flowNodeRef>End_LendingCredit</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start_LendingCredit" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:callActivity id="Call_1_LoanApplication" name="Loan Application" calledElement="Process_LoanApplication"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_2_AffordabilityCreditAssessment" name="Affordability &amp; Credit Assessment" calledElement="Process_AffordabilityCreditAssessment"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_3_UnderwritingDecision" name="Underwriting Decision" calledElement="Process_UnderwritingDecision"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_4_LoanOfferDocumentation" name="Loan Offer &amp; Documentation" calledElement="Process_LoanOfferDocumentation"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_5_LoanBookingDisbursement" name="Loan Booking &amp; Disbursement" calledElement="Process_LoanBookingDisbursement"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_6_LoanRepaymentProcessing" name="Loan Repayment Processing" calledElement="Process_LoanRepaymentProcessing"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_7_ArrearsCollections" name="Arrears &amp; Collections" calledElement="Process_ArrearsCollections"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_8_ForbearanceSupport" name="Forbearance &amp; Financial Difficulty Support" calledElement="Process_ForbearanceSupport"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_9_LoanSettlementClosure" name="Loan Settlement &amp; Closure" calledElement="Process_LoanSettlementClosure"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_10_CreditBureauReporting" name="Credit Bureau Reporting" calledElement="Process_CreditBureauReporting"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_LendingCredit" name="Complete"><bpmn:incoming>Flow_11</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_LendingCredit" targetRef="Call_1_LoanApplication" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Call_1_LoanApplication" targetRef="Call_2_AffordabilityCreditAssessment" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Call_2_AffordabilityCreditAssessment" targetRef="Call_3_UnderwritingDecision" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Call_3_UnderwritingDecision" targetRef="Call_4_LoanOfferDocumentation" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Call_4_LoanOfferDocumentation" targetRef="Call_5_LoanBookingDisbursement" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Call_5_LoanBookingDisbursement" targetRef="Call_6_LoanRepaymentProcessing" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Call_6_LoanRepaymentProcessing" targetRef="Call_7_ArrearsCollections" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="Call_7_ArrearsCollections" targetRef="Call_8_ForbearanceSupport" />
<bpmn:sequenceFlow id="Flow_9" sourceRef="Call_8_ForbearanceSupport" targetRef="Call_9_LoanSettlementClosure" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="Call_9_LoanSettlementClosure" targetRef="Call_10_CreditBureauReporting" />
<bpmn:sequenceFlow id="Flow_11" sourceRef="Call_10_CreditBureauReporting" targetRef="End_LendingCredit" />
</bpmn:process>
<bpmn:collaboration id="Collaboration_LendingCredit"><bpmn:participant id="Participant_LendingCredit" name="Simple Bank" processRef="Process_LendingCredit" /></bpmn:collaboration>
