<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_PaymentsOperations" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_PaymentsOperations" name="Payments &amp; Account Operations" isExecutable="false">
<bpmn:laneSet id="LaneSet_PaymentsOperations"><bpmn:lane id="Lane_PaymentsOperations" name="Simple Bank"><bpmn:flowNodeRef>Start_PaymentsOperations</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_1_InboundPaymentProcessing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_2_OutboundPaymentProcessing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_3_PaymentExceptionsReturns</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_4_PaymentLimitsControls</bpmn:flowNodeRef><bpmn:flowNodeRef>End_PaymentsOperations</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start_PaymentsOperations" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:callActivity id="Call_1_InboundPaymentProcessing" name="Inbound Payment Processing" calledElement="Process_InboundPaymentProcessing"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_2_OutboundPaymentProcessing" name="Outbound Payment Processing" calledElement="Process_OutboundPaymentProcessing"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_3_PaymentExceptionsReturns" name="Payment Exceptions, Returns &amp; Recalls" calledElement="Process_PaymentExceptionsReturns"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_4_PaymentLimitsControls" name="Payment Limits &amp; Authorisation Controls" calledElement="Process_PaymentLimitsControls"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_PaymentsOperations" name="Complete"><bpmn:incoming>Flow_5</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_PaymentsOperations" targetRef="Call_1_InboundPaymentProcessing" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Call_1_InboundPaymentProcessing" targetRef="Call_2_OutboundPaymentProcessing" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Call_2_OutboundPaymentProcessing" targetRef="Call_3_PaymentExceptionsReturns" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Call_3_PaymentExceptionsReturns" targetRef="Call_4_PaymentLimitsControls" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Call_4_PaymentLimitsControls" targetRef="End_PaymentsOperations" />
</bpmn:process>
<bpmn:collaboration id="Collaboration_PaymentsOperations"><bpmn:participant id="Participant_PaymentsOperations" name="Simple Bank" processRef="Process_PaymentsOperations" /></bpmn:collaboration>
<bpmndi:BPMNDiagram id="Diagram_PaymentsOperations"><bpmndi:BPMNPlane id="Plane_PaymentsOperations" bpmnElement="Collaboration_PaymentsOperations">
<bpmndi:BPMNShape id="Participant_PaymentsOperations_di" bpmnElement="Participant_PaymentsOperations" isHorizontal="true"><dc:Bounds x="80" y="80" width="1460" height="260" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_PaymentsOperations_di" bpmnElement="Lane_PaymentsOperations" isHorizontal="true"><dc:Bounds x="110" y="80" width="1430" height="260" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Start_PaymentsOperations_di" bpmnElement="Start_PaymentsOperations"><dc:Bounds x="150" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_1_InboundPaymentProcessing_di" bpmnElement="Call_1_InboundPaymentProcessing"><dc:Bounds x="200" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_2_OutboundPaymentProcessing_di" bpmnElement="Call_2_OutboundPaymentProcessing"><dc:Bounds x="460" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_3_PaymentExceptionsReturns_di" bpmnElement="Call_3_PaymentExceptionsReturns"><dc:Bounds x="720" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_4_PaymentLimitsControls_di" bpmnElement="Call_4_PaymentLimitsControls"><dc:Bounds x="980" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_PaymentsOperations_di" bpmnElement="End_PaymentsOperations"><dc:Bounds x="1260" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="186" y="210" /><di:waypoint x="200" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="210" /><di:waypoint x="460" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="650" y="210" /><di:waypoint x="720" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="910" y="210" /><di:waypoint x="980" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1170" y="210" /><di:waypoint x="1260" y="210" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>