<bpmndi:BPMNShape id="Call_4_SarReporting_di" bpmnElement="Call_4_SarReporting"><dc:Bounds x="980" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_5_FraudMonitoringInvestigation_di" bpmnElement="Call_5_FraudMonitoringInvestigation"><dc:Bounds x="1240" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_6_PeriodicKycReview_di" bpmnElement="Call_6_PeriodicKycReview"><dc:Bounds x="1500" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_FinancialCrime_di" bpmnElement="End_FinancialCrime"><dc:Bounds x="1780" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="186" y="210" /><di:waypoint x="200" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="210" /><di:waypoint x="460" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="650" y="210" /><di:waypoint x="720" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="910" y="210" /><di:waypoint x="980" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1170" y="210" /><di:waypoint x="1240" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1430" y="210" /><di:waypoint x="1500" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1690" y="210" /><di:waypoint x="1780" y="210" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>