<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ExampleBusinessProcess" targetNamespace="https://enterprise-modeler.local/bpmn">
  <bpmn:process id="Process_ExampleBusinessProcess" name="Example Business Process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ExampleBusinessProcess">
      <bpmn:lane id="Lane_ExternalActor" name="External Actor"><bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Operations" name="Operations Team"><bpmn:flowNodeRef>Task_Receive</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Complete</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Request" name="Request received"><bpmn:outgoing>Flow_A</bpmn:outgoing></bpmn:startEvent>
    <bpmn:task id="Task_Receive" name="Record request"><bpmn:incoming>Flow_A</bpmn:incoming><bpmn:outgoing>Flow_B</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Validate" name="Validate request"><bpmn:incoming>Flow_B</bpmn:incoming><bpmn:outgoing>Flow_C</bpmn:outgoing></bpmn:task>
    <bpmn:task id="Task_Complete" name="Complete request"><bpmn:incoming>Flow_C</bpmn:incoming><bpmn:outgoing>Flow_D</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="End_Complete" name="Complete"><bpmn:incoming>Flow_D</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_A" sourceRef="Start_Request" targetRef="Task_Receive" />
    <bpmn:sequenceFlow id="Flow_B" sourceRef="Task_Receive" targetRef="Task_Validate" />
    <bpmn:sequenceFlow id="Flow_C" sourceRef="Task_Validate" targetRef="Task_Complete" />
    <bpmn:sequenceFlow id="Flow_D" sourceRef="Task_Complete" targetRef="End_Complete" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_ExampleBusinessProcess"><bpmn:participant id="Participant_ExampleBusinessProcess" name="Example Organisation" processRef="Process_ExampleBusinessProcess" /></bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_ExampleBusinessProcess"><bpmndi:BPMNPlane id="BPMNPlane_ExampleBusinessProcess" bpmnElement="Collaboration_ExampleBusinessProcess">
    <bpmndi:BPMNShape id="Participant_ExampleBusinessProcess_di" bpmnElement="Participant_ExampleBusinessProcess" isHorizontal="true"><dc:Bounds x="100" y="80" width="1250" height="320" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_ExternalActor_di" bpmnElement="Lane_ExternalActor" isHorizontal="true"><dc:Bounds x="130" y="80" width="1220" height="140" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_Operations_di" bpmnElement="Lane_Operations" isHorizontal="true"><dc:Bounds x="130" y="220" width="1220" height="180" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_Request_di" bpmnElement="Start_Request"><dc:Bounds x="210" y="132" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Receive_di" bpmnElement="Task_Receive"><dc:Bounds x="390" y="270" width="160" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Validate_di" bpmnElement="Task_Validate"><dc:Bounds x="650" y="270" width="160" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Task_Complete_di" bpmnElement="Task_Complete"><dc:Bounds x="910" y="270" width="160" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_Complete_di" bpmnElement="End_Complete"><dc:Bounds x="1170" y="292" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_A_di" bpmnElement="Flow_A"><di:waypoint x="246" y="150" /><di:waypoint x="320" y="150" /><di:waypoint x="320" y="310" /><di:waypoint x="390" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_B_di" bpmnElement="Flow_B"><di:waypoint x="550" y="310" /><di:waypoint x="650" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_C_di" bpmnElement="Flow_C"><di:waypoint x="810" y="310" /><di:waypoint x="910" y="310" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_D_di" bpmnElement="Flow_D"><di:waypoint x="1070" y="310" /><di:waypoint x="1170" y="310" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
