<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EnterpriseOperatingModel" targetNamespace="https://enterprise-modeler.local/bpmn">
  <bpmn:process id="Process_EnterpriseOperatingModel" name="Enterprise Operating Model" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EnterpriseOperatingModel">
      <bpmn:lane id="Lane_EnterpriseOperatingModel_Business" name="Organisation">
        <bpmn:flowNodeRef>Start_EnterpriseOperatingModel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ExampleBusinessProcess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_EnterpriseOperatingModel</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_EnterpriseOperatingModel" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:callActivity id="Activity_ExampleBusinessProcess" name="Example Business Process" calledElement="Process_ExampleBusinessProcess"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:callActivity>
    <bpmn:endEvent id="End_EnterpriseOperatingModel" name="Complete"><bpmn:incoming>Flow_2</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_EnterpriseOperatingModel" targetRef="Activity_ExampleBusinessProcess" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Activity_ExampleBusinessProcess" targetRef="End_EnterpriseOperatingModel" />
  </bpmn:process>
  <bpmn:collaboration id="Collaboration_EnterpriseOperatingModel">
    <bpmn:participant id="Participant_EnterpriseOperatingModel" name="Organisation" processRef="Process_EnterpriseOperatingModel" />
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="BPMNDiagram_EnterpriseOperatingModel"><bpmndi:BPMNPlane id="BPMNPlane_EnterpriseOperatingModel" bpmnElement="Collaboration_EnterpriseOperatingModel">
    <bpmndi:BPMNShape id="Participant_EnterpriseOperatingModel_di" bpmnElement="Participant_EnterpriseOperatingModel" isHorizontal="true"><dc:Bounds x="100" y="80" width="900" height="220" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_EnterpriseOperatingModel_Business_di" bpmnElement="Lane_EnterpriseOperatingModel_Business" isHorizontal="true"><dc:Bounds x="130" y="80" width="870" height="220" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_EnterpriseOperatingModel_di" bpmnElement="Start_EnterpriseOperatingModel"><dc:Bounds x="210" y="172" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Activity_ExampleBusinessProcess_di" bpmnElement="Activity_ExampleBusinessProcess"><dc:Bounds x="390" y="150" width="190" height="80" /></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="End_EnterpriseOperatingModel_di" bpmnElement="End_EnterpriseOperatingModel"><dc:Bounds x="740" y="172" width="36" height="36" /></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="246" y="190" /><di:waypoint x="390" y="190" /></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="580" y="190" /><di:waypoint x="740" y="190" /></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
