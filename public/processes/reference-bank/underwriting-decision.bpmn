<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_UnderwritingDecision" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_UnderwritingDecision" name="Underwriting Decision" isExecutable="false">
<bpmn:laneSet id="LaneSet_UnderwritingDecision">
<bpmn:lane id="Lane_UnderwritingDecision_External" name="Customer / External Party"><bpmn:flowNodeRef>Start_UnderwritingDecision</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_UnderwritingDecision_Bank" name="Bank — Credit Manager"><bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef><bpmn:flowNodeRef>End_UnderwritingDecision</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start_UnderwritingDecision" name="Trigger"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Task_1" name="Review credit assessment"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_2" name="Apply lending policy"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_3" name="Assess exceptions"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_4" name="Approve decline or refer"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_5" name="Record rationale"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="End_UnderwritingDecision" name="Complete"><bpmn:incoming>Flow_6</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_UnderwritingDecision" targetRef="Task_1" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="End_UnderwritingDecision" />
</bpmn:process>
<bpmn:collaboration id="Collaboration_UnderwritingDecision"><bpmn:participant id="Participant_UnderwritingDecision" name="Simple Bank" processRef="Process_UnderwritingDecision" /></bpmn:collaboration>
<bpmndi:BPMNDiagram id="Diagram_UnderwritingDecision"><bpmndi:BPMNPlane id="Plane_UnderwritingDecision" bpmnElement="Collaboration_UnderwritingDecision">
<bpmndi:BPMNShape id="Participant_UnderwritingDecision_di" bpmnElement="Participant_UnderwritingDecision" isHorizontal="true"><dc:Bounds x="80" y="80" width="1490" height="350" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_UnderwritingDecision_External_di" bpmnElement="Lane_UnderwritingDecision_External" isHorizontal="true"><dc:Bounds x="110" y="80" width="1460" height="130" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_UnderwritingDecision_Bank_di" bpmnElement="Lane_UnderwritingDecision_Bank" isHorizontal="true"><dc:Bounds x="110" y="210" width="1460" height="220" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Start_UnderwritingDecision_di" bpmnElement="Start_UnderwritingDecision"><dc:Bounds x="170" y="127" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_1_di" bpmnElement="Task_1"><dc:Bounds x="330" y="260" width="155" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_2_di" bpmnElement="Task_2"><dc:Bounds x="540" y="260" width="155" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_3_di" bpmnElement="Task_3"><dc:Bounds x="750" y="260" width="155" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_4_di" bpmnElement="Task_4"><dc:Bounds x="960" y="260" width="155" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Task_5_di" bpmnElement="Task_5"><dc:Bounds x="1170" y="260" width="155" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_UnderwritingDecision_di" bpmnElement="End_UnderwritingDecision"><dc:Bounds x="1380" y="282" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="206" y="145" /><di:waypoint x="260" y="145" /><di:waypoint x="260" y="300" /><di:waypoint x="330" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="485" y="300" /><di:waypoint x="540" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="695" y="300" /><di:waypoint x="750" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="905" y="300" /><di:waypoint x="960" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1115" y="300" /><di:waypoint x="1170" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1325" y="300" /><di:waypoint x="1380" y="300" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>