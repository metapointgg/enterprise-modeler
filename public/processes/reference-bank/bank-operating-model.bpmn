<bpmn:sequenceFlow id="Flow_8" sourceRef="Call_7_FinanceTreasury" targetRef="Call_8_RiskCompliance" />
<bpmn:sequenceFlow id="Flow_9" sourceRef="Call_8_RiskCompliance" targetRef="Call_9_ProductPartner" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="Call_9_ProductPartner" targetRef="Call_10_TechnologyResilience" />
