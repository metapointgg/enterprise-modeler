<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BankOperatingModel" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_BankOperatingModel" name="Simple Bank Operating Model" isExecutable="false">
<bpmn:laneSet id="LaneSet_BankOperatingModel"><bpmn:lane id="Lane_BankOperatingModel" name="Simple Bank"><bpmn:flowNodeRef>Start_BankOperatingModel</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_1_CustomerOnboarding</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_2_SavingsDeposits</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_3_LendingCredit</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_4_PaymentsOperations</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_5_CustomerServicing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_6_FinancialCrime</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_7_FinanceTreasury</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_8_RiskCompliance</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_9_ProductPartner</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_10_TechnologyResilience</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_11_DataMi</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_12_PeopleCorporate</bpmn:flowNodeRef><bpmn:flowNodeRef>End_BankOperatingModel</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start_BankOperatingModel" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:callActivity id="Call_1_CustomerOnboarding" name="Customer Acquisition &amp; Onboarding" calledElement="Process_CustomerOnboarding"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_2_SavingsDeposits" name="Savings &amp; Deposits" calledElement="Process_SavingsDeposits"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_3_LendingCredit" name="Lending &amp; Credit" calledElement="Process_LendingCredit"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_4_PaymentsOperations" name="Payments &amp; Account Operations" calledElement="Process_PaymentsOperations"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_5_CustomerServicing" name="Customer Servicing &amp; Conduct" calledElement="Process_CustomerServicing"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_6_FinancialCrime" name="Financial Crime &amp; Fraud" calledElement="Process_FinancialCrime"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_7_FinanceTreasury" name="Finance &amp; Treasury" calledElement="Process_FinanceTreasury"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_8_RiskCompliance" name="Risk, Compliance &amp; Governance" calledElement="Process_RiskCompliance"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_9_ProductPartner" name="Product &amp; Partner Management" calledElement="Process_ProductPartner"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_10_TechnologyResilience" name="Technology, Security &amp; Operational Resilience" calledElement="Process_TechnologyResilience"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_11_DataMi" name="Data &amp; Management Information" calledElement="Process_DataMi"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_12_PeopleCorporate" name="People &amp; Corporate Services" calledElement="Process_PeopleCorporate"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_BankOperatingModel" name="Complete"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
