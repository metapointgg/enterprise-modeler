<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CustomerServicing" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_CustomerServicing" name="Customer Servicing &amp; Conduct" isExecutable="false">
<bpmn:laneSet id="LaneSet_CustomerServicing"><bpmn:lane id="Lane_CustomerServicing" name="Simple Bank"><bpmn:flowNodeRef>Start_CustomerServicing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_1_CustomerEnquiries</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_2_ComplaintHandling</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_3_VulnerableCustomerSupport</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_4_BereavementEstateServicing</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_5_FraudScamCustomerReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_6_DataRightsRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Call_7_CustomerCommunications</bpmn:flowNodeRef><bpmn:flowNodeRef>End_CustomerServicing</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="Start_CustomerServicing" name="Start"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:callActivity id="Call_1_CustomerEnquiries" name="Customer Enquiries &amp; Service Requests" calledElement="Process_CustomerEnquiries"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_2_ComplaintHandling" name="Complaint Handling" calledElement="Process_ComplaintHandling"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_3_VulnerableCustomerSupport" name="Vulnerable Customer Support" calledElement="Process_VulnerableCustomerSupport"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_4_BereavementEstateServicing" name="Bereavement &amp; Estate Servicing" calledElement="Process_BereavementEstateServicing"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_5_FraudScamCustomerReport" name="Fraud &amp; Scam Customer Report" calledElement="Process_FraudScamCustomerReport"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_6_DataRightsRequest" name="Data Subject Rights Request" calledElement="Process_DataRightsRequest"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:callActivity>
<bpmn:callActivity id="Call_7_CustomerCommunications" name="Customer Communications Management" calledElement="Process_CustomerCommunications"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:callActivity>
<bpmn:endEvent id="End_CustomerServicing" name="Complete"><bpmn:incoming>Flow_8</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_CustomerServicing" targetRef="Call_1_CustomerEnquiries" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Call_1_CustomerEnquiries" targetRef="Call_2_ComplaintHandling" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Call_2_ComplaintHandling" targetRef="Call_3_VulnerableCustomerSupport" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Call_3_VulnerableCustomerSupport" targetRef="Call_4_BereavementEstateServicing" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Call_4_BereavementEstateServicing" targetRef="Call_5_FraudScamCustomerReport" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Call_5_FraudScamCustomerReport" targetRef="Call_6_DataRightsRequest" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Call_6_DataRightsRequest" targetRef="Call_7_CustomerCommunications" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="Call_7_CustomerCommunications" targetRef="End_CustomerServicing" />
</bpmn:process>
<bpmn:collaboration id="Collaboration_CustomerServicing"><bpmn:participant id="Participant_CustomerServicing" name="Simple Bank" processRef="Process_CustomerServicing" /></bpmn:collaboration>
<bpmndi:BPMNDiagram id="Diagram_CustomerServicing"><bpmndi:BPMNPlane id="Plane_CustomerServicing" bpmnElement="Collaboration_CustomerServicing">
<bpmndi:BPMNShape id="Participant_CustomerServicing_di" bpmnElement="Participant_CustomerServicing" isHorizontal="true"><dc:Bounds x="80" y="80" width="2240" height="260" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Lane_CustomerServicing_di" bpmnElement="Lane_CustomerServicing" isHorizontal="true"><dc:Bounds x="110" y="80" width="2210" height="260" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Start_CustomerServicing_di" bpmnElement="Start_CustomerServicing"><dc:Bounds x="150" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_1_CustomerEnquiries_di" bpmnElement="Call_1_CustomerEnquiries"><dc:Bounds x="200" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_2_ComplaintHandling_di" bpmnElement="Call_2_ComplaintHandling"><dc:Bounds x="460" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_3_VulnerableCustomerSupport_di" bpmnElement="Call_3_VulnerableCustomerSupport"><dc:Bounds x="720" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_4_BereavementEstateServicing_di" bpmnElement="Call_4_BereavementEstateServicing"><dc:Bounds x="980" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_5_FraudScamCustomerReport_di" bpmnElement="Call_5_FraudScamCustomerReport"><dc:Bounds x="1240" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_6_DataRightsRequest_di" bpmnElement="Call_6_DataRightsRequest"><dc:Bounds x="1500" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="Call_7_CustomerCommunications_di" bpmnElement="Call_7_CustomerCommunications"><dc:Bounds x="1760" y="170" width="190" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="End_CustomerServicing_di" bpmnElement="End_CustomerServicing"><dc:Bounds x="2040" y="192" width="36" height="36" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="186" y="210" /><di:waypoint x="200" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="390" y="210" /><di:waypoint x="460" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3"><di:waypoint x="650" y="210" /><di:waypoint x="720" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4"><di:waypoint x="910" y="210" /><di:waypoint x="980" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1170" y="210" /><di:waypoint x="1240" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1430" y="210" /><di:waypoint x="1500" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7"><di:waypoint x="1690" y="210" /><di:waypoint x="1760" y="210" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8"><di:waypoint x="1950" y="210" /><di:waypoint x="2040" y="210" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram></bpmn:definitions>