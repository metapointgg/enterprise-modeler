<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SavingsWithdrawalClosure" targetNamespace="https://enterprise-modeler.local/bpmn">
<bpmn:process id="Process_SavingsWithdrawalClosure" name="Savings Withdrawal &amp; Account Closure" isExecutable="false">
<bpmn:laneSet id="LaneSet_SavingsWithdrawalClosure">
<bpmn:lane id="Lane_SavingsWithdrawalClosure_External" name="Customer / External Party"><bpmn:flowNodeRef>Start_SavingsWithdrawalClosure</bpmn:flowNodeRef></bpmn:lane>
<bpmn:lane id="Lane_SavingsWithdrawalClosure_Bank" name="Bank — Savings Operations Manager"><bpmn:flowNodeRef>Task_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_2</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_3</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_4</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_5</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_6</bpmn:flowNodeRef><bpmn:flowNodeRef>End_SavingsWithdrawalClosure</bpmn:flowNodeRef></bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start_SavingsWithdrawalClosure" name="Trigger"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
<bpmn:task id="Task_1" name="Receive withdrawal or closure request"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_2" name="Authenticate and validate request"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_3" name="Check restrictions and notice"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_4" name="Send payment"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_5" name="Close account if requested"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:task>
<bpmn:task id="Task_6" name="Issue confirmation"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:task>
<bpmn:endEvent id="End_SavingsWithdrawalClosure" name="Complete"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start_SavingsWithdrawalClosure" targetRef="Task_1" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Task_1" targetRef="Task_2" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Task_2" targetRef="Task_3" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Task_3" targetRef="Task_4" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Task_4" targetRef="Task_5" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Task_5" targetRef="Task_6" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Task_6" targetRef="End_SavingsWithdrawalClosure" />
</bpmn:process>
<bpmn:collaboration id="Collaboration_SavingsWithdrawalClosure"><bpmn:participant id="Participant_SavingsWithdrawalClosure" name="Simple Bank" processRef="Process_SavingsWithdrawalClosure" /></bpmn:collaboration>
<bpmndi:BPMNDiagram id="Diagram_SavingsWithdrawalClosure"><bpmndi:BPMNPlane id="Plane_SavingsWithdrawalClosure" bpmnElement="Collaboration_SavingsWithdrawalClosure">
<bpmndi:BPMNShape id="Participant_SavingsWithdrawalClosure_di" bpmnElement="Participant_SavingsWithdrawalClosure" isHorizontal="true"><dc:Bounds x="80" y="80" width="1710" height="350" /></bpmndi:BPMNShape>
