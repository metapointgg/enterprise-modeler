    <bpmn:messageFlow id="if-t24-report-share" name="T24 → Reporting File Share" sourceRef="system-t24" targetRef="system-report-file-share" />
    <bpmn:group id="Group_EFS" categoryValueRef="CategoryValue_EFS" />
