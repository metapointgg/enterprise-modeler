  <bpmn:category id="Category_EFS"><bpmn:categoryValue id="CategoryValue_EFS" value="EFS Document Automation Suite" /></bpmn:category>

  <bpmn:process id="ArchitectureProcess_client-portals" name="Client Portals" isExecutable="false">
    <bpmn:task id="system-broker-portal" name="Broker Portal" />
    <bpmn:task id="system-online-mortgage-portal" name="OMP – Online Mortgage Portal" />
    <bpmn:task id="system-aip-calculator" name="AIP Calculator" />
    <bpmn:task id="system-risk-calculator" name="Risk Calculator" />
    <bpmn:task id="system-credit-team-portal" name="Credit Team Portal" />
    <bpmn:task id="system-indulge-management-portal" name="Indulge Management Portal" />
    <bpmn:task id="system-indulge-customer-portal" name="Indulge Customer Portal" />
    <bpmn:task id="system-emortgages" name="eMortgages" />
    <bpmn:task id="system-sio" name="SIO – Skipton International Online" />
    <bpmn:task id="system-hid" name="HID" />
    <bpmn:sequenceFlow id="if-sio-hid" name="SIO ↔ HID" sourceRef="system-sio" targetRef="system-hid" />
    <bpmn:sequenceFlow id="if-indulge-management-hid" name="Indulge Management Portal ↔ HID" sourceRef="system-indulge-management-portal" targetRef="system-hid" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_core-platforms" name="Core Platforms" isExecutable="false">
    <bpmn:task id="system-salesforce" name="Salesforce" />
