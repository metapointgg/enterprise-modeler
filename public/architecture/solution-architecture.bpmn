    <bpmn:messageFlow id="if-salesforce-bragi" name="Salesforce ↔ BRAGI" sourceRef="system-salesforce" targetRef="system-bragi" />
    <bpmn:messageFlow id="if-t24-sql" name="T24 → SQL Staging" sourceRef="system-t24" targetRef="system-sql-staging" />
    <bpmn:messageFlow id="if-bragi-tableau" name="BRAGI → Tableau" sourceRef="system-bragi" targetRef="system-tableau" />
    <bpmn:messageFlow id="if-bip-hsbc" name="BIP ↔ HSBC" sourceRef="system-bip" targetRef="system-hsbc" />
    <bpmn:messageFlow id="if-t24-bip" name="T24 ↔ BIP" sourceRef="system-t24" targetRef="system-bip" />
    <bpmn:messageFlow id="if-sio-t24" name="SIO ↔ T24" sourceRef="system-sio" targetRef="system-t24" />
    <bpmn:messageFlow id="if-indulge-management-hid" name="Indulge Management Portal ↔ HID" sourceRef="system-indulge-management-portal" targetRef="system-hid" />
    <bpmn:messageFlow id="if-hid-t24-registration" name="HID → T24 User Registration" sourceRef="system-hid" targetRef="system-t24" />
  </bpmn:collaboration>

