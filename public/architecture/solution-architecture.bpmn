    <bpmn:messageFlow id="if-bip-hsbc" name="BIP ↔ HSBC" sourceRef="system-bip" targetRef="system-hsbc" />
    <bpmn:messageFlow id="if-indulge-management-hid" name="Indulge Management Portal ↔ HID" sourceRef="system-indulge-management-portal" targetRef="system-hid" />
    <bpmn:group id="Group_EFS" categoryValueRef="CategoryValue_EFS" />
  </bpmn:collaboration>

