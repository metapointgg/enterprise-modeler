<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ClientSolutionArchitecture" targetNamespace="https://enterprise-modeler.local/client-architecture">
  <bpmn:process id="ArchitectureProcess_channel" name="Channels &amp; Experience" isExecutable="false">
    <bpmn:task id="system-broker-portal" name="Broker Portal" />
    <bpmn:task id="system-online-mortgage-portal" name="Online Mortgage Portal" />
    <bpmn:task id="system-aip-calculator" name="AIP Calculator" />
    <bpmn:task id="system-risk-calculator" name="Risk Calculator" />
    <bpmn:task id="system-credit-team-portal" name="Credit Team Portal" />
    <bpmn:task id="system-indulge-management-portal" name="Indulge Management Portal" />
    <bpmn:task id="system-indulge-customer-portal" name="Indulge Customer Portal" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_integration" name="Integration &amp; Data Movement" isExecutable="false">
    <bpmn:task id="system-bragi" name="BRAGI" />
    <bpmn:task id="system-sql-staging" name="SQL Staging" />
    <bpmn:task id="system-bip" name="BIP" />
    <bpmn:sequenceFlow id="if-sql-bragi" name="SQL Staging → BRAGI" sourceRef="system-sql-staging" targetRef="system-bragi" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_platform" name="Core Platforms, Documents &amp; Reporting" isExecutable="false">
    <bpmn:task id="system-salesforce" name="Salesforce" />
    <bpmn:task id="system-jade" name="JADE" />
    <bpmn:task id="system-emortgages" name="eMortgages" />
    <bpmn:task id="system-t24" name="T24" />
    <bpmn:task id="system-tableau" name="Tableau" />
    <bpmn:task id="system-fcm" name="FCM" />
    <bpmn:task id="system-ln-gen-doc" name="LN Gen Doc" />
    <bpmn:task id="system-om-doc-mgmt" name="OM Doc Mgmt" />
    <bpmn:task id="system-bpm-print-auto" name="BPM Print Auto" />
    <bpmn:task id="system-file-server-repo" name="File Server Repo" />
    <bpmn:task id="system-report-file-share" name="Reporting File Share" />
    <bpmn:sequenceFlow id="if-jade-emortgages" name="JADE ↔ eMortgages" sourceRef="system-jade" targetRef="system-emortgages" />
    <bpmn:sequenceFlow id="if-fcm-t24" name="FCM → T24" sourceRef="system-fcm" targetRef="system-t24" />
    <bpmn:sequenceFlow id="if-t24-ln-gen-doc" name="T24 → LN Gen Doc" sourceRef="system-t24" targetRef="system-ln-gen-doc" />
    <bpmn:sequenceFlow id="if-t24-om-doc" name="T24 ↔ OM Doc Mgmt" sourceRef="system-t24" targetRef="system-om-doc-mgmt" />
    <bpmn:sequenceFlow id="if-ln-doc-om-doc" name="LN Gen Doc → OM Doc Mgmt" sourceRef="system-ln-gen-doc" targetRef="system-om-doc-mgmt" />
    <bpmn:sequenceFlow id="if-om-doc-bpm" name="OM Doc Mgmt → BPM Print Auto" sourceRef="system-om-doc-mgmt" targetRef="system-bpm-print-auto" />
    <bpmn:sequenceFlow id="if-om-doc-file-repo" name="OM Doc Mgmt → File Server Repo" sourceRef="system-om-doc-mgmt" targetRef="system-file-server-repo" />
    <bpmn:sequenceFlow id="if-t24-report-share" name="T24 → Reporting File Share" sourceRef="system-t24" targetRef="system-report-file-share" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_security" name="Identity &amp; Access" isExecutable="false">
    <bpmn:task id="system-sio" name="SIO" />
    <bpmn:task id="system-hid" name="HID" />
    <bpmn:sequenceFlow id="if-sio-hid" name="SIO ↔ HID" sourceRef="system-sio" targetRef="system-hid" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_partner" name="External Providers" isExecutable="false">
    <bpmn:task id="system-hsbc" name="HSBC" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_other" name="Other / TBC" isExecutable="false">
    <bpmn:task id="system-gfs" name="GFS" />
    <bpmn:task id="system-nabu" name="NABU" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_ClientSolutionArchitecture">
    <bpmn:participant id="ArchitectureLayer_channel" name="Channels &amp; Experience" processRef="ArchitectureProcess_channel" />
    <bpmn:participant id="ArchitectureLayer_integration" name="Integration &amp; Data Movement" processRef="ArchitectureProcess_integration" />
    <bpmn:participant id="ArchitectureLayer_platform" name="Core Platforms, Documents &amp; Reporting" processRef="ArchitectureProcess_platform" />
    <bpmn:participant id="ArchitectureLayer_security" name="Identity &amp; Access" processRef="ArchitectureProcess_security" />
    <bpmn:participant id="ArchitectureLayer_partner" name="External Providers" processRef="ArchitectureProcess_partner" />
    <bpmn:participant id="ArchitectureLayer_other" name="Other / TBC" processRef="ArchitectureProcess_other" />
    <bpmn:messageFlow id="if-broker-jade" name="Broker Portal ↔ JADE" sourceRef="system-broker-portal" targetRef="system-jade" />
    <bpmn:messageFlow id="if-broker-salesforce" name="Broker Portal ↔ Salesforce" sourceRef="system-broker-portal" targetRef="system-salesforce" />
