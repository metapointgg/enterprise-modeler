    <bpmn:task id="system-t24" name="T24" />
    <bpmn:task id="system-bip" name="BIP" />
    <bpmn:task id="system-fcm" name="FCM" />
    <bpmn:task id="system-gfs" name="GFS" />
    <bpmn:sequenceFlow id="if-t24-bip" name="T24 ↔ BIP" sourceRef="system-t24" targetRef="system-bip" />
    <bpmn:sequenceFlow id="if-fcm-t24" name="FCM → T24" sourceRef="system-fcm" targetRef="system-t24" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_data-reporting" name="Data / Reporting" isExecutable="false">
    <bpmn:task id="system-bragi" name="BRAGI" />
    <bpmn:task id="system-sql-staging" name="SQL Staging" />
    <bpmn:task id="system-tableau" name="Tableau" />
    <bpmn:task id="system-ln-gen-doc" name="LN (Document Generation)" />
    <bpmn:task id="system-om-doc-mgmt" name="DM (Document Management)" />
    <bpmn:task id="system-bpm-print-auto" name="BPM (Print Automation)" />
    <bpmn:task id="system-file-server-repo" name="File Server Repo" />
    <bpmn:task id="system-report-file-share" name="Reporting File Share" />
    <bpmn:task id="system-nabu" name="NABU" />
    <bpmn:sequenceFlow id="if-sql-bragi" name="SQL Staging → BRAGI" sourceRef="system-sql-staging" targetRef="system-bragi" />
    <bpmn:sequenceFlow id="if-bragi-tableau" name="BRAGI → Tableau" sourceRef="system-bragi" targetRef="system-tableau" />
    <bpmn:sequenceFlow id="if-ln-doc-om-doc" name="EFS LN → DM" sourceRef="system-ln-gen-doc" targetRef="system-om-doc-mgmt" />
    <bpmn:sequenceFlow id="if-om-doc-bpm" name="EFS DM → BPM" sourceRef="system-om-doc-mgmt" targetRef="system-bpm-print-auto" />
    <bpmn:sequenceFlow id="if-om-doc-file-repo" name="EFS DM → File Server Repo" sourceRef="system-om-doc-mgmt" targetRef="system-file-server-repo" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_third-party" name="Third Party Integration" isExecutable="false">
    <bpmn:task id="system-hsbc" name="HSBC" />
  </bpmn:process>

  <bpmn:collaboration id="Collaboration_ClientSolutionArchitecture">
