    <bpmn:sequenceFlow id="if-om-doc-bpm" name="EFS DM → BPM" sourceRef="system-om-doc-mgmt" targetRef="system-bpm-print-auto" />
    <bpmn:sequenceFlow id="if-om-doc-file-repo" name="EFS DM → File Server Repo" sourceRef="system-om-doc-mgmt" targetRef="system-file-server-repo" />
    <bpmn:sequenceFlow id="if-t24-report-share" name="T24 → Reporting File Share" sourceRef="system-t24" targetRef="system-report-file-share" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_third-party" name="Third Party Integration" isExecutable="false">
