    <bpmn:task id="system-nabu" name="NABU" />
    <bpmn:sequenceFlow id="if-jade-emortgages" name="JADE ↔ eMortgages" sourceRef="system-jade" targetRef="system-emortgages" />
    <bpmn:sequenceFlow id="if-salesforce-bragi" name="Salesforce ↔ BRAGI" sourceRef="system-salesforce" targetRef="system-bragi" />
