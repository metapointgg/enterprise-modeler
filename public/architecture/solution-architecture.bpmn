<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EnterpriseSolutionArchitecture" targetNamespace="https://enterprise-modeler.local/architecture">

  <bpmn:process id="ArchitectureProcess_channel" name="Channels &amp; Experience" isExecutable="false">
    <bpmn:task id="system-online-banking" name="Digital Banking Portal" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_integration" name="API &amp; Integration" isExecutable="false">
    <bpmn:task id="system-payments" name="Payments Gateway" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_platform" name="Core Platforms &amp; Data" isExecutable="false">
    <bpmn:task id="system-salesforce" name="Salesforce CRM" />
    <bpmn:task id="system-t24" name="Temenos Transact (T24)" />
    <bpmn:task id="system-iris" name="IRIS Financials" />
    <bpmn:task id="system-sharepoint" name="Microsoft SharePoint Online" />
    <bpmn:task id="system-data-warehouse" name="Bank Data Warehouse" />
    <bpmn:task id="system-powerbi" name="Microsoft Power BI" />
    <bpmn:task id="system-servicenow" name="ServiceNow" />
    <bpmn:task id="system-treasury-alm" name="Treasury &amp; ALM Tool" />
    <bpmn:task id="system-m365" name="Microsoft 365" />
    <bpmn:task id="system-hris" name="HR Information System" />
    <bpmn:task id="system-reg-reporting" name="Regulatory Reporting Workspace" />
    <bpmn:sequenceFlow id="if-salesforce-t24" name="Salesforce ↔ T24 Customer &amp; Account Interface" sourceRef="system-salesforce" targetRef="system-t24" />
    <bpmn:sequenceFlow id="if-salesforce-sharepoint" name="Salesforce ↔ SharePoint Documents" sourceRef="system-salesforce" targetRef="system-sharepoint" />
    <bpmn:sequenceFlow id="if-t24-iris" name="T24 → IRIS GL Interface" sourceRef="system-t24" targetRef="system-iris" />
    <bpmn:sequenceFlow id="if-t24-dwh" name="T24 → Data Warehouse" sourceRef="system-t24" targetRef="system-data-warehouse" />
    <bpmn:sequenceFlow id="if-salesforce-dwh" name="Salesforce → Data Warehouse" sourceRef="system-salesforce" targetRef="system-data-warehouse" />
    <bpmn:sequenceFlow id="if-iris-dwh" name="IRIS → Data Warehouse" sourceRef="system-iris" targetRef="system-data-warehouse" />
    <bpmn:sequenceFlow id="if-t24-treasury" name="T24 → Treasury &amp; ALM" sourceRef="system-t24" targetRef="system-treasury-alm" />
    <bpmn:sequenceFlow id="if-dwh-powerbi" name="Data Warehouse → Power BI" sourceRef="system-data-warehouse" targetRef="system-powerbi" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_security" name="Identity, Security &amp; Control" isExecutable="false">
    <bpmn:task id="system-aml-monitoring" name="AML Transaction Monitoring Platform" />
    <bpmn:task id="system-fraud-monitoring" name="Fraud Monitoring Platform" />
    <bpmn:task id="system-entra" name="Microsoft Entra ID" />
    <bpmn:task id="system-sentinel" name="Microsoft Sentinel" />
    <bpmn:task id="system-backup" name="Enterprise Backup Service" />
    <bpmn:sequenceFlow id="if-security-sentinel" name="Enterprise Systems → Sentinel" sourceRef="system-entra" targetRef="system-sentinel" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_partner" name="External Providers" isExecutable="false">
    <bpmn:task id="system-worldcheck" name="LSEG World-Check One" />
    <bpmn:task id="system-idv" name="Digital Identity Verification Service" />
    <bpmn:task id="system-experian" name="Experian Credit Bureau" />
    <bpmn:task id="system-docusign" name="DocuSign" />
  </bpmn:process>

  <bpmn:process id="ArchitectureProcess_other" name="Other / TBC" isExecutable="false" />

  <bpmn:collaboration id="Collaboration_EnterpriseSolutionArchitecture">
    <bpmn:participant id="ArchitectureLayer_channel" name="Channels &amp; Experience" processRef="ArchitectureProcess_channel" />
    <bpmn:participant id="ArchitectureLayer_integration" name="API &amp; Integration" processRef="ArchitectureProcess_integration" />
    <bpmn:participant id="ArchitectureLayer_platform" name="Core Platforms &amp; Data" processRef="ArchitectureProcess_platform" />
    <bpmn:participant id="ArchitectureLayer_security" name="Identity, Security &amp; Control" processRef="ArchitectureProcess_security" />
    <bpmn:participant id="ArchitectureLayer_partner" name="External Providers" processRef="ArchitectureProcess_partner" />
    <bpmn:participant id="ArchitectureLayer_other" name="Other / TBC" processRef="ArchitectureProcess_other" />
    <bpmn:messageFlow id="if-salesforce-idv" name="Salesforce → Identity Verification" sourceRef="system-salesforce" targetRef="system-idv" />
    <bpmn:messageFlow id="if-salesforce-worldcheck" name="Salesforce → World-Check Screening" sourceRef="system-salesforce" targetRef="system-worldcheck" />
    <bpmn:messageFlow id="if-salesforce-experian" name="Salesforce → Experian Credit Search" sourceRef="system-salesforce" targetRef="system-experian" />
    <bpmn:messageFlow id="if-salesforce-docusign" name="Salesforce ↔ DocuSign" sourceRef="system-salesforce" targetRef="system-docusign" />
    <bpmn:messageFlow id="if-t24-payments" name="T24 ↔ Payments Gateway" sourceRef="system-t24" targetRef="system-payments" />
    <bpmn:messageFlow id="if-t24-aml" name="T24 → AML Monitoring Feed" sourceRef="system-t24" targetRef="system-aml-monitoring" />
    <bpmn:messageFlow id="if-t24-fraud" name="T24 → Fraud Monitoring Feed" sourceRef="system-t24" targetRef="system-fraud-monitoring" />
    <bpmn:messageFlow id="if-app-salesforce" name="Digital Banking → Salesforce" sourceRef="system-online-banking" targetRef="system-salesforce" />
    <bpmn:messageFlow id="if-app-t24" name="Digital Banking → T24" sourceRef="system-online-banking" targetRef="system-t24" />
  </bpmn:collaboration>

  <bpmndi:BPMNDiagram id="BPMNDiagram_EnterpriseSolutionArchitecture">
