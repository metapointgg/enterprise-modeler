<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_ClientSolutionArchitecture" targetNamespace="https://enterprise-modeler.local/client-architecture">
  <bpmn:category id="Category_EFS"><bpmn:categoryValue id="CategoryValue_EFS" value="EFS Document Automation Suite" /></bpmn:category>

  <bpmn:process id="ArchitectureProcess_client-facing" name="Client Facing / Portals" isExecutable="false">
